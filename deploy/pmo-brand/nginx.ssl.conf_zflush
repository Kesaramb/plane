# TEMPORARY — one-time cache flush after the PMO rebrand. Safe to delete after a few days.
#
# Installed at: /home/admin/conf/web/pmo.gobrandfactory.com/nginx.ssl.conf_zflush
# (the z prefix only matters for ordering when reading the drop-ins; nginx does not care)
#
# WHY THIS EXISTS
# Plane's built assets carry a content hash in the filename and no Cache-Control header
# at all. Browsers therefore cache them heuristically, at roughly a tenth of the file's
# age — which for a bundle built in April is about twelve days. The rebrand patches those
# files in place and keeps the filenames, so anyone who opened the app recently keeps
# serving the old Plane bundle from disk and never asks the server for the new one.
#
# Clear-Site-Data on the HTML response tells the browser to drop its cache for this
# origin, so the next load fetches the patched assets. It applies to the document only:
# /assets/ and /pmo-brand/ set their own add_header, and an nginx location with any
# add_header of its own does not inherit the server-level ones.
#
# ONLY "cache". Adding "cookies" or "storage" would sign every member of staff out.
#
# The /api/ block below exists solely to stop this header riding along on API responses.
# nginx does not inherit server-level add_header into a location that sets one of its own,
# so giving /api/ its own header is what confines the flush to the HTML document. Without
# it every API call would re-clear the cache and the whole bundle would download again.
#
# REMOVE THIS once the team has loaded the app once (a few days is plenty). Leaving it in
# place makes every visit re-download the whole bundle:
#   rm /home/admin/conf/web/pmo.gobrandfactory.com/nginx.ssl.conf_zflush && nginx -t && systemctl reload nginx
add_header Clear-Site-Data '"cache"' always;

location /api/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
    client_max_body_size 100m;
    add_header Cache-Control "no-store" always;
}
