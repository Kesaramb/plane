# --- in-app and link-preview imagery ---------------------------------------
location = /assets/gradient-logo-BKMvbTcN.webp {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/gradient-logo.webp;
}
location = /assets/og-image-DL-1GVBU.png {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/og-image.png;
