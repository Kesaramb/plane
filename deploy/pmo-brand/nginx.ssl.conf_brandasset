# PMO brand assets, and overrides that point Plane's own brand images at ours.
#
# Installed at: /home/admin/conf/web/pmo.gobrandfactory.com/nginx.ssl.conf_brandasset
#
# The exact= locations below carry Vite build hashes from the SPA bundle. They are
# how the app gets rebranded without a JavaScript build, and they are the first
# thing to re-check after a Plane upgrade — see README.md.

# brand.js changes far more often than the artwork. It must never be cached, or a
# fix sits behind whatever expiry the previous version was served with — an exact
# match wins over the prefix location below.
location = /pmo-brand/brand.js {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/brand.js;
    open_file_cache off;
    expires off;
    add_header Cache-Control "no-store" always;
    default_type application/javascript;
}

# Public on purpose: email clients fetch the logo with no session of any kind.
# A day is long enough to save the round trips and short enough that replacing the
# logo actually shows up the same day.
location ^~ /pmo-brand/ {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/;
    add_header Cache-Control "public, max-age=86400" always;
    access_log off;
}

# The app's HTML document is served with no Cache-Control whatsoever, so browsers cache it
# heuristically and keep serving an old copy. That is the single most damaging gap here:
# the document is what carries the injected banner script, and it is what points at every
# other asset. A stale one silently undoes the entire rebrand, with nothing in the logs.
#
# no-store on the document, at server level. Locations that set an add_header of their own
# (/assets/, /pmo-brand/, the manifests) do not inherit it, which is exactly what we want —
# only the HTML needs to be uncacheable. It is a few KB, gzipped, once per page load.
#
# NOTE: the landing page at / is a static file and already sets no-store separately; do not
# confuse the two when checking this. Test /sign-in, not /.
add_header Cache-Control "no-store" always;

# Plane ships its hashed assets with no Cache-Control at all, so browsers fall back to
# heuristic caching. That is normally harmless — a content hash in the filename means the
# URL changes whenever the bytes do. It is NOT harmless here, because the PMO rebrand
# patches those files in place and deliberately keeps the filenames. Without this, a
# returning browser keeps serving the old Plane bundle from cache and never asks again.
#
# Five minutes bounds how long a patch takes to reach people, without turning every asset
# into a conditional request on every page load. Exact-match overrides below still win.
location /assets/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "max-age=300, must-revalidate" always;
}

