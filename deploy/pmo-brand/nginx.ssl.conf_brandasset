# --- PWA manifests: both say "Plane" in the stock build --------------------
location = /manifest.json {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/manifest.json;
    default_type application/manifest+json;
    # own add_header so the temporary Clear-Site-Data flush is not inherited here:
    # manifests are fetched without credentials and the browser rejects it noisily
    add_header Cache-Control "max-age=300, must-revalidate" always;
}
location = /site.webmanifest.json {
    alias /home/admin/web/pmo.gobrandfactory.com/pmo-brand/site.webmanifest.json;
    default_type application/manifest+json;
    # own add_header so the temporary Clear-Site-Data flush is not inherited here:
    # manifests are fetched without credentials and the browser rejects it noisily
    add_header Cache-Control "max-age=300, must-revalidate" always;
}
