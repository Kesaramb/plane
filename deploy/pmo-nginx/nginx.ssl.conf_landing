location = / {
    root /home/admin/web/pmo.gobrandfactory.com/landing;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    # Back from signing in to connect Claude (see nginx.ssl.conf_mcp). Plane's sign-in
    # ends at /?next_path=<path> and leaves the app to navigate there in the browser,
    # and the app would route /api/... as one of its own pages and 404. Hop server-side.
    # Must come before the hand-off below, which would serve the app for this request.
    if ($arg_next_path = "/api/pmo/connector/resume/") {
        return 302 /api/pmo/connector/resume/;
    }
    # hand off to Plane for a session OR any auth flow param — see plane_pmo.conf
    if ($pmo_serve_app) {
        proxy_pass http://127.0.0.1:4100;
    }
    add_header Cache-Control "no-store";
    try_files /index.html =404;
}
