location = / {
    root /home/admin/web/pmo.gobrandfactory.com/landing;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    # Back from signing in to the Claude connector or the dashboard: hop to resume. Only
    # when signed in ($pmo_resume_hop, plane_pmo.conf) — signed out, this same URL is the
    # sign-in page. Must come before the hand-off below, which would serve the app.
    if ($pmo_resume_hop) {
        return 302 /api/pmo/connector/resume/;
    }
    # hand off to Plane for a session OR any auth flow param — see plane_pmo.conf
    if ($pmo_serve_app) {
        proxy_pass http://127.0.0.1:4100;
    }
    add_header Cache-Control "no-store";
    try_files /index.html =404;
}
